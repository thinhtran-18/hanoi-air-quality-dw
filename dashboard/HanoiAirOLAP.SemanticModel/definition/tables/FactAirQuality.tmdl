table FactAirQuality
	lineageTag: 36e951cb-9adf-462a-ade8-55c42257966a

	measure 'Đo lường'
		lineageTag: 475742af-d498-4a3a-9a9b-c9ee8f77ebc9

	/// Số quan sát hợp lệ trong ngữ cảnh lọc.
	measure 'Số phép đo hợp lệ' = CALCULATE(COUNTROWS('FactAirQuality'), 'FactAirQuality'[IsValid] = TRUE())
		formatString: #,##0
		lineageTag: 1701c096-3197-4cfd-b21c-3add1fac6e88

	/// Trung bình các phép đo hợp lệ của một chất; để trống khi chọn nhiều chất.
	measure 'Nồng độ trung bình' = IF(HASONEVALUE('DimPollutant'[PollutantCode]), CALCULATE(AVERAGE('FactAirQuality'[Value]), 'FactAirQuality'[IsValid] = TRUE()), BLANK())
		formatString: #,##0.00
		lineageTag: 5337e6cf-fcc8-4a7a-889c-808e157dc962

	/// Trung bình PM2.5 của các phép đo hợp lệ trong bộ lọc hiện tại; không suy rộng cho khoảng thiếu.
	measure 'PM2.5 trung bình (µg/m³)' = CALCULATE(AVERAGE('FactAirQuality'[Value]), 'FactAirQuality'[IsValid] = TRUE(), KEEPFILTERS('DimPollutant'[PollutantCode] = "pm25"))
		formatString: #,##0.00
		lineageTag: 5ea44139-4be2-49d1-b803-746439b03317

