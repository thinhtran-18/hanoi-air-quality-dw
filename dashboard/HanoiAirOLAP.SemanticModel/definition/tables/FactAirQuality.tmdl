table FactAirQuality
	lineageTag: 36e951cb-9adf-462a-ade8-55c42257966a

	measure 'Đo lường'
		lineageTag: 475742af-d498-4a3a-9a9b-c9ee8f77ebc9

	/// Số quan sát hợp lệ trong ngữ cảnh lọc; không mặc định là số giờ khi có nhiều trạm/chất/cảm biến.
	measure 'Số phép đo hợp lệ' = CALCULATE(COUNTROWS('FactAirQuality'), 'FactAirQuality'[IsValid] = TRUE())
		formatString: #,##0
		lineageTag: 1701c096-3197-4cfd-b21c-3add1fac6e88

	/// Trung bình các phép đo hợp lệ của một chất; trả về BLANK() khi chưa chọn đúng một chất.
	measure 'Nồng độ trung bình' = IF(HASONEVALUE('DimPollutant'[PollutantCode]), CALCULATE(AVERAGE('FactAirQuality'[Value]), 'FactAirQuality'[IsValid] = TRUE()), BLANK())
		formatString: #,##0.00
		lineageTag: 5337e6cf-fcc8-4a7a-889c-808e157dc962

	/// Trung bình PM2.5 của các phép đo hợp lệ trong bộ lọc hiện tại; không suy rộng cho khoảng thiếu.
	measure 'PM2.5 trung bình (µg/m³)' = CALCULATE([Nồng độ trung bình], 'DimPollutant'[PollutantCode] = "pm25")
		formatString: #,##0.00
		lineageTag: 5ea44139-4be2-49d1-b803-746439b03317

	/// Trung bình PM10 của các phép đo hợp lệ trong bộ lọc hiện tại; không suy rộng cho khoảng thiếu.
	measure 'PM10 trung bình (µg/m³)' = CALCULATE([Nồng độ trung bình], 'DimPollutant'[PollutantCode] = "pm10")
		formatString: #,##0.00

	/// Giá trị lớn nhất của các phép đo hợp lệ trong ngữ cảnh một chất; trả về BLANK() khi trộn nhiều chất.
	measure 'Cực đại (µg/m³)' = IF(HASONEVALUE('DimPollutant'[PollutantCode]), CALCULATE(MAX('FactAirQuality'[Value]), 'FactAirQuality'[IsValid] = TRUE()), BLANK())
		formatString: #,##0.00

	/// Giá trị nhỏ nhất của các phép đo hợp lệ trong ngữ cảnh một chất; trả về BLANK() khi trộn nhiều chất.
	measure 'Cực tiểu (µg/m³)' = IF(HASONEVALUE('DimPollutant'[PollutantCode]), CALCULATE(MIN('FactAirQuality'[Value]), 'FactAirQuality'[IsValid] = TRUE()), BLANK())
		formatString: #,##0.00

	/// Giá trị PM2.5 lớn nhất trong bộ lọc hiện tại.
	measure 'PM2.5 cực đại (µg/m³)' = CALCULATE([Cực đại (µg/m³)], 'DimPollutant'[PollutantCode] = "pm25")
		formatString: #,##0.00

	/// Giá trị PM10 lớn nhất trong bộ lọc hiện tại.
	measure 'PM10 cực đại (µg/m³)' = CALCULATE([Cực đại (µg/m³)], 'DimPollutant'[PollutantCode] = "pm10")
		formatString: #,##0.00

	/// Số ngày địa phương phân biệt có ít nhất một phép đo hợp lệ.
	measure 'Số ngày có dữ liệu' = CALCULATE(DISTINCTCOUNT('FactAirQuality'[DateKey]), 'FactAirQuality'[IsValid] = TRUE())
		formatString: #,##0

	/// Số mốc giờ địa phương phân biệt có ít nhất một phép đo hợp lệ trong ngữ cảnh lọc.
	measure 'Số giờ quan sát' = CALCULATE(COUNTROWS(SUMMARIZE('FactAirQuality', 'FactAirQuality'[DateKey], 'FactAirQuality'[TimeKey])), 'FactAirQuality'[IsValid] = TRUE())
		formatString: #,##0

	/// Số giờ phân biệt theo từng cặp trạm–chất có phép đo hợp lệ (dùng để đối chiếu độ phủ).
	measure 'Số giờ trạm-chất' = CALCULATE(COUNTROWS(SUMMARIZE('FactAirQuality', 'FactAirQuality'[DateKey], 'FactAirQuality'[TimeKey], 'FactAirQuality'[StationKey], 'FactAirQuality'[PollutantKey])), 'FactAirQuality'[IsValid] = TRUE())
		formatString: #,##0

	column AirQualityKey
		dataType: int64
		isHidden
		formatString: 0
