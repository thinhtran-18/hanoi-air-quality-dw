table StationPairHourly
	lineageTag: 4ace16b6-6f9e-4e0a-bb0a-abc27577029f

	/// Số giờ địa phương đồng thời mà cả hai trạm cùng có phép đo hợp lệ cho cùng chất.
	measure 'Số giờ ghép cặp' = COUNTROWS('StationPairHourly')
		formatString: #,##0
		lineageTag: fa94b5c1-3fb3-4f2a-b117-e3e91460a9e9

	/// Trung bình nồng độ tại Hàng Đậu tính trên tập giờ ghép cặp của một chất.
	measure 'TB Hàng Đậu (giờ chung, µg/m³)' = IF(HASONEVALUE('DimPollutant'[PollutantCode]), AVERAGE('StationPairHourly'[ValueHangDau]), BLANK())
		formatString: #,##0.00
		lineageTag: d6161d2f-9645-44e8-a924-26c59c603267

	/// Trung bình nồng độ tại Khương Trung tính trên tập giờ ghép cặp của một chất.
	measure 'TB Khương Trung (giờ chung, µg/m³)' = IF(HASONEVALUE('DimPollutant'[PollutantCode]), AVERAGE('StationPairHourly'[ValueKhuongTrung]), BLANK())
		formatString: #,##0.00
		lineageTag: d4b5ff78-f617-4665-9080-03c85ac032e1

	/// Chênh lệch trung bình (Hàng Đậu - Khương Trung) tính bằng µg/m³ trên cùng tập giờ ghép cặp; không phải phần trăm.
	measure 'Chênh lệch TB (HĐ - KT, µg/m³)' = IF(HASONEVALUE('DimPollutant'[PollutantCode]), AVERAGE('StationPairHourly'[Difference]), BLANK())
		formatString: +#,##0.00;-#,##0.00;0.00
		lineageTag: 909e768e-4168-4843-8510-104e7fc316b0

	/// Thông báo trạng thái khi không có giờ chung hoặc đang có giờ ghép cặp.
	measure 'Thông báo giờ ghép cặp' = IF(COUNTROWS('StationPairHourly') = 0, "Không có giờ chung giữa hai trạm trong bộ lọc hiện tại.", "Đang đối chiếu " & FORMAT(COUNTROWS('StationPairHourly'), "#,##0") & " giờ đo đồng thời tại cả hai trạm.")
		lineageTag: 289c7e88-48ab-4cbd-b6e7-e5093043130f

	column HourLocal
		dataType: dateTime
