                "textRuns": [
                  {
                    "value": "QUY TẮC DIỄN GIẢI & ĐỘ PHỦ DỮ LIỆU",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI",
                      "fontSize": "15px",
                      "color": "#0f172a"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Thẻ PM2.5 TB và PM10 TB cố định theo từng chất; không gộp chung PM2.5 và PM10.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13px",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Năm nhuận 2024 có 366 ngày (8.784 giờ/trạm/chất). Độ phủ thực tế đạt 28,44%–37,03%; tháng 8/2024 trống hoàn toàn.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13px",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Giờ thiếu không phải nồng độ 0 và mẫu hiện có chưa đại diện cả năm hay toàn Hà Nội.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13px",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• So sánh công bằng hai trạm trên tập giờ ghép cặp thực hiện tại trang 03_So_sanh_tra_cuu.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13px",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Không gọi nồng độ là AQI và không suy luận nguyên nhân khi thiếu dữ liệu thời tiết/giao thông.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13px",
                      "color": "#334155"
                    }
                  }
                ]
              }
            ]
          }
