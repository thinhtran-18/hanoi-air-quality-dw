        <mxCell id="note1" value="UQ độ phủ: (DateKey, StationKey, PollutantKey). Không nối trực tiếp hai fact, không gắn DimTime/DimSensor vào fact ngày." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=20;">
