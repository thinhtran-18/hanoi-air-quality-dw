        <mxCell id="note0" value="FactAirQuality: trạm + cảm biến + thời điểm UTC + chất. FactCoverageDaily: ngày local + trạm + chất." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=20;">
