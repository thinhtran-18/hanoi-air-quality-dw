      <Commands>
        <Command>
          <Text>CALCULATE; CREATE MEMBER CURRENTCUBE.[Measures].[Mean Concentration] AS IIF([Pollutant].[Pollutant].CurrentMember IS [Pollutant].[Pollutant].[All], NULL, IIF([Measures].[Observation Count]=0, NULL, [Measures].[Value Sum Internal]/[Measures].[Observation Count])), FORMAT_STRING = "0.00", VISIBLE = 1;</Text>
        </Command>
      </Commands>
    </MdxScript>
